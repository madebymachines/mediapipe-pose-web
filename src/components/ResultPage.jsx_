import React, { useState, useRef, useEffect } from "react";
import logo from "../assets/logo.png";
import runnerImg from "../assets/runner.png";
import { 
  ChevronLeftIcon, 
  PlayIcon, 
  PauseIcon,
  ShareIcon,
  ArrowDownTrayIcon 
} from "@heroicons/react/24/outline";
import axios from "axios";

const ResultPage = ({ song, user, onBack }) => {
  const [isPlaying, setIsPlaying] = useState(false);
  const [currentTime, setCurrentTime] = useState(0);
  const [duration, setDuration] = useState(0);
  const [videoUrl, setVideoUrl] = useState(null);
  const [isLoadingVideo, setIsLoadingVideo] = useState(false);
  const [videoStatus, setVideoStatus] = useState(null);
  const [isDownloading, setIsDownloading] = useState(false);
  const [videoBlob, setVideoBlob] = useState(null);
  const [isChecking, setIsChecking] = useState(false);
  const [showStatusModal, setShowStatusModal] = useState(false); 
  const audioRef = useRef(null);
  const pollingIntervalRef = useRef(null);
  const retryCountRef = useRef(0);
  const lastRequestTimeRef = useRef(0);

  const backendUrl = import.meta.env.VITE_BACKEND_URL;

  // Update time display
  useEffect(() => {
    const audio = audioRef.current;
    if (!audio) return;

    const updateTime = () => setCurrentTime(audio.currentTime);
    const updateDuration = () => setDuration(audio.duration);

    audio.addEventListener('timeupdate', updateTime);
    audio.addEventListener('loadedmetadata', updateDuration);
    audio.addEventListener('ended', () => setIsPlaying(false));

    return () => {
      audio.removeEventListener('timeupdate', updateTime);
      audio.removeEventListener('loadedmetadata', updateDuration);
      audio.removeEventListener('ended', () => setIsPlaying(false));
    };
  }, []);

  const checkVideoStatus = async () => {
    if (!song.job_id) {
      console.log('❌ No job_id found');
      return false;
    }
    
    // Rate limiting protection
    const now = Date.now();
    const timeSinceLastRequest = now - lastRequestTimeRef.current;
    if (timeSinceLastRequest < 2000) {
      console.log('⚠️ Rate limiting protection: waiting before next request');
      await new Promise(resolve => setTimeout(resolve, 2000 - timeSinceLastRequest));
    }
    
    try {
      lastRequestTimeRef.current = Date.now();
      console.log('🎬 Checking video status for job ID:', song.job_id);
      
      const response = await axios.get(`${backendUrl}/video-status/${song.job_id}`, {
        timeout: 10000,
        headers: {
          'Accept': 'application/json',
          'Cache-Control': 'no-cache'
        }
      });
      
      console.log('📹 Video response:', response.data);
      
      const status = response.data.video?.status;
      setVideoStatus(status);
      
      if (status === 'COMPLETE' && response.data.video?.downloadUrl) {
        console.log('✅ Video URL found:', response.data.video.downloadUrl);
        setVideoUrl(response.data.video.downloadUrl);
        return true; // Video ready
      } else {
        console.log('⏳ Video not ready yet. Status:', status);
        return false; // Video not ready
      }
      
    } catch (error) {
      console.error('❌ Error checking video status:', error);
      
      if (error.response?.status === 429) {
        setVideoStatus('RATE_LIMITED');
      } else if (error.code === 'ECONNABORTED') {
        setVideoStatus('TIMEOUT');
      } else {
        setVideoStatus('ERROR');
      }
      
      return false;
    }
  };

  const startPolling = () => {
    if (pollingIntervalRef.current) return; 
    
    console.log('🔄 Starting video status polling...');
    
    pollingIntervalRef.current = setInterval(async () => {
      const isReady = await checkVideoStatus();
      
      if (isReady) {
        // Video is ready, download it
        console.log('✅ Video is ready, downloading...');
        await downloadVideoFile(videoUrl);
        
        // Stop polling
        if (pollingIntervalRef.current) {
          clearInterval(pollingIntervalRef.current);
          pollingIntervalRef.current = null;
        }
        
        setIsChecking(false);
        setShowStatusModal(false);
      } else if (videoStatus === 'FAILED' || videoStatus === 'ERROR') {
        // Stop polling on failure
        if (pollingIntervalRef.current) {
          clearInterval(pollingIntervalRef.current);
          pollingIntervalRef.current = null;
        }
        setIsChecking(false);
      }
    }, 5000); // Check every 5 seconds
  };

  const stopPolling = () => {
    if (pollingIntervalRef.current) {
      clearInterval(pollingIntervalRef.current);
      pollingIntervalRef.current = null;
    }
  };

  // Cleanup on unmount
  useEffect(() => {
    return () => stopPolling();
  }, []);

  // Function to download video file as blob
  const downloadVideoFile = async (url) => {
    if (videoBlob || !url) return;
    
    try {
      setIsDownloading(true);
      console.log('📥 Downloading video file...');
      
      const response = await fetch(url, {
        method: 'GET',
        headers: {
          'Cache-Control': 'no-cache'
        }
      });
      
      if (!response.ok) {
        throw new Error(`Download failed: ${response.status}`);
      }
      
      const blob = await response.blob();
      setVideoBlob(blob);
      console.log('✅ Video file downloaded successfully!', blob.size, 'bytes');
      
    } catch (error) {
      console.error('❌ Error downloading video file:', error);
    } finally {
      setIsDownloading(false);
    }
  };

  // Play/Pause toggle
  const togglePlayPause = () => {
    const audio = audioRef.current;
    if (isPlaying) {
      audio.pause();
    } else {
      audio.play();
    }
    setIsPlaying(!isPlaying);
  };

  // Progress bar click handler
  const handleProgressClick = (e) => {
    const audio = audioRef.current;
    const progressBar = e.currentTarget;
    const clickX = e.clientX - progressBar.getBoundingClientRect().left;
    const width = progressBar.offsetWidth;
    const newTime = (clickX / width) * duration;
    audio.currentTime = newTime;
    setCurrentTime(newTime);
  };

  // Format time display
  const formatTime = (time) => {
    if (isNaN(time) || !isFinite(time)) return "0:00";
    const minutes = Math.floor(time / 60);
    const seconds = Math.floor(time % 60);
    return `${minutes}:${seconds.toString().padStart(2, '0')}`;
  };

  // Get status message
  const getStatusMessage = () => {
    switch (videoStatus) {
      case 'PENDING':
        return 'Video is being prepared...';
      case 'PROGRESSING':
        return 'Video is being generated...';
      case 'COMPLETE':
        return isDownloading ? 'Downloading video file...' : 'Video is ready!';
      case 'FAILED':
        return 'Video generation failed';
      case 'RATE_LIMITED':
        return 'Too many requests. Please wait...';
      case 'TIMEOUT':
        return 'Request timeout. Please try again...';
      case 'ERROR':
        return 'Error checking video status';
      default:
        return 'Checking video status...';
    }
  };

  // Share function with on-demand status check
  const handleShare = async () => {
    // If video is already ready, share immediately
    if (videoBlob && videoStatus === 'COMPLETE') {
      await shareVideoFile();
      return;
    }

    // If no job_id, fallback to audio sharing
    if (!song.job_id) {
      return;
    }

    // Start checking video status
    setIsChecking(true);
    setShowStatusModal(true);
    
    try {
      const isReady = await checkVideoStatus();
      
      if (isReady) {
        // Video is ready, download and share
        await downloadVideoFile(videoUrl);
        await shareVideoFile();
        setIsChecking(false);
        setShowStatusModal(false);
      } else {
        // Video not ready, start polling
        if (videoStatus === 'PROGRESSING' || videoStatus === 'PENDING') {
          startPolling();
        } else {
          // Video failed or other error
          setIsChecking(false);
          setTimeout(() => setShowStatusModal(false), 3000); // Auto-close after 3s
        }
      }
    } catch (error) {
      console.error('❌ Error in handleShare:', error);
      setIsChecking(false);
      setShowStatusModal(false);
    }
  };

  // Share video file function
  const shareVideoFile = async () => {
    if (!videoBlob) return;
    
    const shareTitle = `${song.title} - AI Generated Song`;
    const shareText = `Check out my AI-generated song: "${song.title}" written by ${user.name}`;
    
    if (navigator.share) {
      try {
        const videoFile = new File([videoBlob], `${song.title}-video.mp4`, { 
          type: 'video/mp4' 
        });
        
        await navigator.share({
          title: shareTitle,
          text: shareText,
          files: [videoFile]
        });
        
        console.log('✅ Successfully shared video file');
      } catch (error) {
        if (error.name !== 'AbortError') {
          console.error('❌ Error sharing video file:', error);
        }
      }
    }
  };

  // Close status modal
  const closeStatusModal = () => {
    setShowStatusModal(false);
    setIsChecking(false);
    stopPolling();
  };

  // Check if video is ready for sharing
  const isVideoReady = videoStatus === 'COMPLETE' && videoBlob && !isDownloading;

  return (
    <>
      {/* Hidden audio element */}
      <audio
        ref={audioRef}
        src={song.audio?.url || "/demo.mp3"}
        onLoadedMetadata={() => setDuration(audioRef.current.duration)}
      />

      {/* Chevron + Logo */}
      <div className="w-full flex items-center justify-between my-6 px-2">
        <button className="p-1" onClick={onBack} aria-label="Back">
          <ChevronLeftIcon className="w-7 h-7 text-white hover:opacity-80" />
        </button>
        <img
          src={logo}
          alt="Acer Intel"
          className="w-48 md:w-56"
          draggable="false"
          style={{ objectFit: "contain" }}
        />
        <span className="w-7" />
      </div>

      {/* Song Cover */}
      <div className="w-[310px] h-[240px] rounded-lg mb-6 flex items-center justify-center bg-black/10 overflow-hidden shadow-md">
        <img
          src={runnerImg}
          alt="song"
          className="object-cover w-full h-full"
          draggable="false"
        />
      </div>

      {/* Song Title & Author */}
      <div className="mb-6 text-white text-left w-full max-w-[310px]">
        <div className="text-2xl font-extrabold leading-tight mb-1 tracking-widest">
          {song.title || "GO! GO! GO!"}
        </div>
        <div className="text-base mb-4 font-medium text-white/80">
          Written by @{song.social_username || user.name}
        </div>
      </div>

      {/* Custom Audio Player */}
      <div className="w-80 mb-8">
        {/* Progress Bar */}
        <div className="mb-4">
          <div 
            className="w-full h-1 bg-white/30 rounded-full cursor-pointer"
            onClick={handleProgressClick}
          >
            <div 
              className="h-full bg-white rounded-full transition-all duration-100"
              style={{ 
                width: duration ? `${(currentTime / duration) * 100}%` : '0%' 
              }}
            />
          </div>
          {/* Time Display */}
          <div className="flex justify-between text-white text-sm mt-2">
            <span>{formatTime(currentTime)}</span>
            <span>-{formatTime(duration - currentTime)}</span>
          </div>
        </div>

        {/* Play/Pause Button */}
        <div className="flex justify-center mb-0 -mt-4">
          <button
            onClick={togglePlayPause}
            className="w-16 h-16 bg-white rounded-full flex items-center justify-center hover:bg-gray-100 transition-colors shadow-lg"
            aria-label={isPlaying ? "Pause" : "Play"}
          >
            {isPlaying ? (
              <PauseIcon className="w-8 h-8 text-purple-600 ml-0.5" />
            ) : (
              <PlayIcon className="w-8 h-8 text-purple-600 ml-1" />
            )}
          </button>
        </div>
      </div>

      {/* Action Buttons */}
      <div className="w-80 space-y-4 mb-5">
        {/* 🔥 NEW: Video ready indicator (only show when video is ready) */}
        {isVideoReady && (
          <div className="text-center text-sm font-medium text-green-400">
            ✅ Video ready to share!
          </div>
        )}

        {/* 🔥 MODIFIED: Share Button - Always enabled, checks status on click */}
        <button
          onClick={handleShare}
          disabled={isChecking}
          className={`w-full border-2 font-bold py-3 rounded-md text-lg tracking-widest uppercase transition flex items-center justify-center gap-2 ${
            isChecking
              ? 'border-white/40 text-white/40 bg-transparent cursor-not-allowed opacity-60'
              : isVideoReady
              ? 'border-green-400 text-green-400 bg-transparent active:scale-95 hover:bg-green-400/10'
              : 'border-white text-white bg-transparent active:scale-95 hover:bg-white/10'
          }`}
          style={{ letterSpacing: ".13em" }}
        >
          {isChecking ? (
            <>
              <div className="animate-spin rounded-full h-5 w-5 border-b-2 border-white/40"></div>
              <span>Checking...</span>
            </>
          ) : (
            <>
              <ShareIcon className="w-5 h-5" />
              <span>{isVideoReady ? 'Share Video' : 'Share'}</span>
            </>
          )}
        </button>
      </div>

      {/* 🔥 NEW: Status Modal */}
      {showStatusModal && (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50">
          <div className="bg-white/10 backdrop-blur-md rounded-lg p-6 mx-4 max-w-sm w-full">
            <div className="text-center">
              <div className="mb-4">
                {(videoStatus === 'PROGRESSING' || videoStatus === 'PENDING' || isChecking) && (
                  <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-white mx-auto"></div>
                )}
                {videoStatus === 'COMPLETE' && (
                  <div className="w-8 h-8 rounded-full bg-green-400 flex items-center justify-center mx-auto">
                    <span className="text-white text-sm">✓</span>
                  </div>
                )}
                {(videoStatus === 'FAILED' || videoStatus === 'ERROR') && (
                  <div className="w-8 h-8 rounded-full bg-red-400 flex items-center justify-center mx-auto">
                    <span className="text-white text-sm">✗</span>
                  </div>
                )}
              </div>
              
              <h3 className="text-white font-bold mb-2">Video Status</h3>
              <p className="text-white/80 text-sm mb-4">{getStatusMessage()}</p>
              
              {(videoStatus === 'FAILED' || videoStatus === 'ERROR' || videoStatus === 'RATE_LIMITED' || videoStatus === 'TIMEOUT') && (
                <button
                  onClick={closeStatusModal}
                  className="bg-white/20 text-white px-4 py-2 rounded-md hover:bg-white/30 transition"
                >
                  Close
                </button>
              )}
              
              {(videoStatus === 'PROGRESSING' || videoStatus === 'PENDING') && (
                <button
                  onClick={closeStatusModal}
                  className="bg-white/20 text-white px-4 py-2 rounded-md hover:bg-white/30 transition"
                >
                  Cancel
                </button>
              )}
            </div>
          </div>
        </div>
      )}
    </>
  );
};

export default ResultPage;